# Runtime. Set production only after every required value below is configured.
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=300

# PostgreSQL and Redis
DATABASE_URL=postgresql+asyncpg://nourishbot:change-me@localhost:5432/nourishbot
DATABASE_URL_SYNC=postgresql+psycopg2://nourishbot:change-me@localhost:5432/nourishbot
REDIS_URL=redis://localhost:6379/0
DB_ECHO=false
DEFAULT_RESTAURANT_ID=1

# Authentication. Generate a long random value for production.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY_MINUTES=480
AUTH_COOKIE_NAME=nourishbot_session
CUSTOMER_IDENTITY_COOKIE_NAME=nourishbot_customer_identity
AUTH_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
OAUTH_STATE_COOKIE_NAME=nourishbot_oauth_state
OAUTH_STATE_TTL_SECONDS=600
CONFIRMATION_TTL_MINUTES=15
IDENTITY_LINK_TTL_MINUTES=10
CONSENT_POLICY_VERSION=2026-10
MESSAGE_RETENTION_DAYS=30
LOCATION_RETENTION_DAYS=7
PROVIDER_RESPONSE_RETENTION_DAYS=30

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_PRIMARY_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_FALLBACK_2_MODEL=gpt-3.5-turbo

# Telegram polling
TELEGRAM_BOT_ENABLED=true
TELEGRAM_TOKEN=your_telegram_bot_token

# WhatsApp Cloud API webhook. Keep disabled until the Meta app is configured.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Mandatory future scheduling policy
MIN_SCHEDULE_LEAD_MINUTES=30
MAX_SCHEDULE_DAYS=14
SCHEDULE_ACTIVATION_LEAD_MINUTES=20
SCHEDULE_CONFIRMATION_REMINDER_MINUTES=1440
SCHEDULE_FULFILLMENT_REMINDER_MINUTES=60
SCHEDULE_LATE_GRACE_MINUTES=10
SCHEDULE_LATE_POLICY=MANUAL_REVIEW
SCHEDULE_JOB_MAX_ATTEMPTS=5
SCHEDULE_JOB_BATCH_SIZE=50
SCHEDULE_LEASE_SECONDS=120
SCHEDULE_RETRY_BASE_SECONDS=30
SCHEDULE_RETRY_MAX_SECONDS=1800
SCHEDULER_HEARTBEAT_STALE_SECONDS=180
OUTBOX_LEASE_SECONDS=600
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300

# MCP providers. Transaction tools are blocked unless their schema includes a
# native scheduling field; NourishBot never falls back to instant checkout.
MCP_ENABLED=false
MCP_TRANSACTIONAL_ENABLED=false
NPX_BIN=npx
MCP_AUTH_DIR=
MCP_TOOL_TIMEOUT_S=45
MCP_RECONNECT_COOLDOWN_S=30
MCP_ZOMATO_ENABLED=true
MCP_SWIGGY_FOOD_ENABLED=true
MCP_ZOMATO_URL=https://mcp-server.zomato.com/mcp
MCP_SWIGGY_FOOD_URL=https://mcp.swiggy.com/food

# Read-only restaurant discovery and drive-through search along a driving route.
# Enable Places API (New) and Routes API for this key.
GOOGLE_MAPS_API_KEY=
MAPS_REQUEST_TIMEOUT_S=15

# Optional public listing links (informational only, never used for instant checkout)
ZOMATO_URL=
SWIGGY_URL=

# Optional Razorpay payment intents
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_BASE_URL=
